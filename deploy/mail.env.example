MAIL_PUBLIC_ORIGIN=https://mail.example.com
MAIL_PROXY_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
MAIL_DATA_DIR=/opt/mail/.local
MAIL_BACKGROUND_SYNC=1
# Optional: enable APNs once the Apple Developer key is provisioned.
# APNS_KEY_FILE=/opt/mail/.local/apns.p8
# APNS_KEY_ID=YOUR_KEY_ID
# APNS_TEAM_ID=YOUR_TEAM_ID
# APNS_TOPIC=com.daniezl.mail
